# cp .env.example .env, then fill in real keys

OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# langsmith optional, leave blank to disable
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-intelligence-system

# postgres — used by docker-compose.yml AND the app
POSTGRES_USER=finai
POSTGRES_PASSWORD=finai_password_change_me
POSTGRES_DB=financial_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
